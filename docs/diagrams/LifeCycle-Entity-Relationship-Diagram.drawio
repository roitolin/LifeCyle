          <mxGeometry x="1130" y="850" width="480" height="1180" as="geometry" />
        </mxCell>
        <mxCell id="c-patterns" value="&lt;b&gt;Relationship patterns used by LifeCycle&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Optional 1:1&lt;/b&gt; - users.id is both PK and FK in funeral_shops; a user can have at most one shop profile.&lt;br&gt;&lt;b&gt;1:N&lt;/b&gt; - one shop owns many products and receives many service requests.&lt;br&gt;&lt;b&gt;M:N&lt;/b&gt; - represented by bridge tables such as shop_follows, service_request_members, funeral_product_ratings and user_blocks on the detail tabs." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="2120" width="1030" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c-accuracy" value="&lt;b&gt;Accuracy notes&lt;/b&gt;&lt;br&gt;&lt;br&gt;Only database-enforced foreign keys receive connectors. conversations.participants is a UUID array, and funeral_service_requests.productId is text, so neither is drawn as an FK relationship. The detail tabs show every relationship column relevant to each domain." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1170" y="2120" width="920" height="220" as="geometry" />
        </mxCell>
        <mxCell id="c-footer" value="Notation: PK = primary key | FK = foreign key | UQ = unique | ? = nullable | Bridge = associative table" style="text;html=1;align=center;verticalAlign=middle;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="2380" width="1900" height="35" as="geometry" />
        </mxCell>
        <mxCell id="ce1" value="id (PK/FK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c-auth" target="c-users">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" value="id (PK/FK)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERone;startFill=0;endArrow=ERzeroToOne;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c-users" target="c-shops">
