td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;acceptedAt : timestamptz?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;declinedAt : timestamptz?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;cancelledAt : timestamptz?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;shopRespondedAt : timestamptz?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;FK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;handledByShopId : uuid?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;paymentPlanEnabled : boolean&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;createdAt : timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td