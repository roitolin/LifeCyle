        <mxCell id="s-note2" value="&lt;b&gt;Shop-column detail&lt;/b&gt;&lt;br&gt;&lt;br&gt;funeral_service_requests.shopId references funeral_shops.id. By contrast, operational shop_id columns in checklists, schedules and refunds reference public.users.id. The diagram preserves that exact difference." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="600" y="1470" width="760" height="190" as="geometry" />
        </mxCell>
        <mxCell id="s-note3" value="&lt;b&gt;Member bridge detail&lt;/b&gt;&lt;br&gt;&lt;br&gt;service_request_members implements request/user sharing. user_id is nullable because an invitation can exist by email before it is linked to a registered account. invited_by is always a registered user." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1470" width="760" height="190" as="geometry" />
        </mxCell>
