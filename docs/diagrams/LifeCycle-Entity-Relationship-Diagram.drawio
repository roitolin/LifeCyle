        </mxCell>
        <mxCell id="m-note3" value="&lt;b&gt;Delete behavior&lt;/b&gt;&lt;br&gt;&lt;br&gt;Owned catalog and bridge rows use ON DELETE CASCADE. Optional review shop references use ON DELETE SET NULL, preserving the review when the shop profile is removed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
