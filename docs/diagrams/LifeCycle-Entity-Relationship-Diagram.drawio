          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ae2" value="quote_id" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.45;entryX=0;entryY=0.45;" edge="1" parent="1" source="a-quotes" target="a-items">
