        <mxCell id="a-note1" value="&lt;b&gt;Relationship rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;A service request can have many quote versions, documents and payment milestones. Each quote can have many line items. A milestone may optionally point to the quote that established it." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="1450" width="750" height="190" as="geometry" />
        </mxCell>
        <mxCell id="a-note2" value="&lt;b&gt;Role-FK rule&lt;/b&gt;&lt;br&gt;&lt;br&gt;shop_id and created_by are required user references. assignee_id, verified_by and submitted_by are nullable user references. Multiple role columns are grouped on labeled connectors to keep the ERD readable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="1450" width="750" height="190" as="geometry" />
        </mxCell>
        <mxCell id="a-note3" value="&lt;b&gt;Scope note&lt;/b&gt;&lt;br&gt;&lt;br&gt;These tables are present in the current Supabase schema. This page documents database storage and does not imply that every arrangement function is exposed in every current client screen." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1730" y="1450" width="750" height="190" as="geometry" />
        </mxCell>
