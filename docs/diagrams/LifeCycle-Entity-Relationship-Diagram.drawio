        </mxCell>
        <mxCell id="m-note1" value="&lt;b&gt;M:N explained&lt;/b&gt;&lt;br&gt;&lt;br&gt;A user can follow many shops, and a shop can be followed by many users. The shop_follows row stores that association and prevents duplicate user/shop pairs with a composite unique constraint." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="960" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="m-note3" value="&lt;b&gt;Self-referencing bridge&lt;/b&gt;&lt;br&gt;&lt;br&gt;user_blocks links public.users to the same table twice: blockerId identifies the acting user and blockedId identifies the blocked user. The composite unique constraint prevents duplicate pairs." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1360" y="960" width="800" height="200" as="geometry" />
        </mxCell>
        <mxCell id="m-footer" value="Every connector represents an actual REFERENCES constraint in the project SQL." style="text;html=1;align=center;verticalAlign=middle;fontColor=#6B7280;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="1240" width="1600" height="35" as="geometry" />
        </mxCell>
        <mxCell id="me11" value="userId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.7;entryX=0;entryY=0.55;" edge="1" parent="1" source="m-users" target="m-follows">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me12" value="shopId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.5;exitY=1;entryX=0.55;entryY=0;" edge="1" parent="1" source="m-shops" target="m-follows">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me13" value="blockerId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="m-users" target="m-blocks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="me14" value="blockedId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="m-users" target="m-blocks">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
