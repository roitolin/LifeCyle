        <mxCell id="m-note2" value="&lt;b&gt;Review-key detail&lt;/b&gt;&lt;br&gt;&lt;br&gt;funeral_product_ratings uses a text primary key with the application format {productKey}_{userId}. productId and userId are real foreign keys. shopId is nullable and uses ON DELETE SET NULL." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
