        <mxCell id="f-support" value="&lt;table cellpadding='0' cellspacing='0' style='width:100%;height:100%;border-collapse:collapse;font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#111827;background:#FFFFFF'&gt;&lt;tr&gt;&lt;td colspan='2' style='height:28px;padding:6px 8px;background:#F3F4F6;border-bottom:1px solid #6B7280;text-align:center;font-size:12px'&gt;&lt;b&gt;public.support_messages&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='padding:4px 7px;color:#6B7280;border-bottom:1px solid #D1D5DB;font-size:10px;text-align:left'&gt;&lt;font color=#059669&gt;Customer support contact&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;PK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;id : uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;FK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;userId : uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;email : text?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;subject : text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;message : text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;read : boolean&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;status : text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;channel : text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;createdAt : timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacing=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1950" y="940" width="410" height="256" as="geometry" />
        </mxCell>
        <mxCell id="f-note1" value="&lt;b&gt;Important physical-model detail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Conversation membership is stored in conversations.participants as uuid[]. It is checked by row-level-security logic, but it is not a relational foreign key. readBy, deliveredTo and replyToId are also not FK constrained." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="1220" width="800" height="210" as="geometry" />
        </mxCell>
        <mxCell id="f-note2" value="&lt;b&gt;Notification distinction&lt;/b&gt;&lt;br&gt;&lt;br&gt;notifications stores user-facing records. push_notification_tokens stores one or more registered devices for a user. The globally unique Expo token prevents the same token from being stored twice." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="950" y="1220" width="780" height="210" as="geometry" />
        </mxCell>
        <mxCell id="f-note3" value="&lt;b&gt;Feedback thread&lt;/b&gt;&lt;br&gt;&lt;br&gt;One app_feedback row can have many replies. Every feedback post, reply, rating and support message belongs to one user even when its display is marked anonymous." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1810" y="1220" width="780" height="210" as="geometry" />
        </mxCell>
