        <mxCell id="s-schedule" value="&lt;table cellpadding='0' cellspacing='0' style='width:100%;height:100%;border-collapse:collapse;font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#111827;background:#FFFFFF'&gt;&lt;tr&gt;&lt;td colspan='2' style='height:28px;padding:6px 8px;background:#F3F4F6;border-bottom:1px solid #6B7280;text-align:center;font-size:12px'&gt;&lt;b&gt;public.shop_schedule_events&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='padding:4px 7px;color:#6B7280;border-bottom:1px solid #D1D5DB;font-size:10px;text-align:left'&gt;&lt;font color=#C2410C&gt;Shop calendar item&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;PK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;id : uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;FK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;shop_id : uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;title : text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;event_type : text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;event_date : date&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;start_time : time&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;end_time : time?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;location : text?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;notes : text?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;FK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;related_service_request_id : uuid?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;created_at : timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3