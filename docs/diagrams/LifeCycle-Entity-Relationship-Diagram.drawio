        <mxCell id="s-death" value="&lt;table cellpadding='0' cellspacing='0' style='width:100%;height:100%;border-collapse:collapse;font-family:Helvetica,Arial,sans-serif;font-size:11px;color:#111827;background:#FFFFFF'&gt;&lt;tr&gt;&lt;td colspan='2' style='height:28px;padding:6px 8px;background:#F3F4F6;border-bottom:1px solid #6B7280;text-align:center;font-size:12px'&gt;&lt;b&gt;death_certificate_requests&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan='2' style='padding:4px 7px;color:#6B7280;border-bottom:1px solid #D1D5DB;font-size:10px;text-align:left'&gt;&lt;font color=#7C3AED&gt;Preserved optional 1:1 record; current app does not expose it&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;PK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;id : uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;UQ/FK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;service_request_id : uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;status : text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;file_url : text?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;FK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;requested_by : uuid&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;requested_at : timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;FK&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;processed_by : uuid?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;completed_at : timestamptz?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='width:50px;padding:3px 4px;border-right:1px solid #D1D5DB;border-bottom:1px solid #E5E7EB;text-align:center;font-weight:bold;color:#374151'&gt;&lt;/td&gt;&lt;td style='padding:3px 7px;border-bottom:1px solid #E5E7EB;text-align:left'&gt;updated_at : timestamptz&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="shape=rectangle;rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B5563;strokeWidth=1;fontColor=#111827;fontSize=13;align=left;verticalAlign=top;spacing=0;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1940" y="180" width="430" height="256" as="geometry" />
        </mxCell>
        <mxCell id="s-note1" value="&lt;b&gt;Why these are 1:1&lt;/b&gt;&lt;br&gt;&lt;br&gt;A checklist uses service_request_id as both its primary key and foreign key. A death-certificate row has a UNIQUE foreign key. Both rules allow zero or one extension row for each service request - never more than one." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="1550" width="800" height="210" as="geometry" />
        </mxCell>
        <mxCell id="s-note2" value="&lt;b&gt;Shop-column detail&lt;/b&gt;&lt;br&gt;&lt;br&gt;funeral_service_requests.shopId references funeral_shops.id. By contrast, operational shop_id columns in checklists, schedules and refunds reference public.users.id. The diagram preserves that exact difference." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1550" width="800" height="210" as="geometry" />
        </mxCell>
        <mxCell id="se1" value="requesterId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=ERone;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeColor=#4B5563;strokeWidth=1.5;fontColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;exitX=1;exitY=0.35;entryX=0;entryY=0.3;" edge="1" parent="1" source="s-users" target="s-requests">
