        <mxCell id="x-note2" value="&lt;b&gt;Shop-payment detail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Despite its column name, shop_payments.shopId references public.users.id, not funeral_shops.id. The table stores the payment submitted for shop-account verification." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="700" y="1220" width="820" height="190" as="geometry" />
        </mxCell>
        <mxCell id="x-note3" value="&lt;b&gt;Final migration state&lt;/b&gt;&lt;br&gt;&lt;br&gt;The temporary adminStatus, adminScope, adminInvitedBy, roleUpdatedBy and MFA profile columns were removed by the later pause_admin_security migration; they are intentionally absent here." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#D1D5DB;strokeWidth=1;fontColor=#374151;fontSize=13;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" vertex="1" parent="1">
