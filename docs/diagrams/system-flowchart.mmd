flowchart TD
    START([Start]) --> AUTH{Signed in?}
    AUTH -->|No| ACCOUNT[Register, verify email, or sign in]
    ACCOUNT --> AUTH
    AUTH -->|Yes| ROLE{Account role}

    ROLE -->|Family customer| HOME[Browse funeral services]
    HOME --> SEARCH[Search verified funeral shops]
    SEARCH --> CATALOG[Review shop catalog and products]
    CATALOG --> CHOICE{Choose request type}
    CHOICE -->|Catalog item| CART[Add item to cart]
    CHOICE -->|Custom casket| CUSTOM[Submit custom casket details]
    CART --> CHECKOUT[Enter deceased, coordinator, schedule, and payment details]
    CHECKOUT --> SUBMIT[Submit arrangement request]
    CUSTOM --> SUBMIT
    SUBMIT --> TRACK[Track request, payment, preparation, and completion]
    TRACK --> CHAT[Coordinate with the funeral shop]

    ROLE -->|Funeral shop owner or staff| SHOP_STATUS{Shop registered?}
    SHOP_STATUS -->|No| SHOP_REGISTER[Submit shop and business information]
    SHOP_REGISTER --> VERIFY[Administrator reviews verification]
    VERIFY -->|Needs changes| SHOP_REGISTER
    VERIFY -->|Approved| SHOP_CENTER[Open Shop Center]
    SHOP_STATUS -->|Yes| SHOP_CENTER
    SHOP_CENTER --> PRODUCTS[Manage catalog, products, stock, and custom offerings]
    SHOP_CENTER --> INBOX[Review incoming arrangement cases]
    SHOP_CENTER --> SCHEDULE[Manage preparation schedule]
    SHOP_CENTER --> REPORTS[Review customers, payments, and reports]
    INBOX --> DECISION{Accept request?}
    DECISION -->|No| DECLINE[Record decline reason and notify customer]
    DECISION -->|Yes| PREPARE[Confirm payment and prepare service]
    PREPARE --> PROOF[Upload completion proof]
    PROOF --> CUSTOMER_CONFIRM[Customer reviews completion]
    CUSTOMER_CONFIRM --> CLOSED[Close arrangement]

    ROLE -->|Administrator| ADMIN[Open administration dashboard]
    ADMIN --> ADMIN_SHOPS[Review funeral shops]
    ADMIN --> ADMIN_USERS[Manage users and roles]
    ADMIN --> ADMIN_ORDERS[Review arrangements, products, payments, and refunds]
    ADMIN --> ADMIN_CONTENT[Manage announcements and home content]
    ADMIN --> ADMIN_SUPPORT[Handle support, feedback, moderation, and account deletion]
    ADMIN --> ADMIN_SECURITY[Review analytics, audit logs, and login security]

    HOME --> SHARED[Notifications, profile, settings, support, and feedback]
    SHOP_CENTER --> SHARED
    ADMIN --> SHARED
    SHARED --> LOGOUT[Sign out]
    LOGOUT --> AUTH

    subgraph DATA[Supabase services]
        DB[(PostgreSQL data)]
        STORAGE[(Supabase Storage)]
        REALTIME[Realtime messages and notifications]
        PUSH[Expo Push Service]
    end

    ACCOUNT --> DB
    SUBMIT --> DB
    PRODUCTS --> DB
    INBOX --> DB
    ADMIN --> DB
    CHECKOUT --> STORAGE
    CUSTOM --> STORAGE
    PROOF --> STORAGE
    CHAT --> REALTIME
    REALTIME --> PUSH
