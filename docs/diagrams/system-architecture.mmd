flowchart LR
    subgraph ACTORS[Actors]
        CUSTOMER[Family customer]
        SHOP[Funeral shop owner or staff]
        ADMIN[Administrator]
    end

    subgraph CLIENTS[Client applications]
        MOBILE[Expo React Native mobile app]
        WEB[Vite React web app]
    end

    subgraph MODULES[Application modules]
        AUTH[Authentication and account security]
        MARKETPLACE[Shop discovery, catalog, cart, and favorites]
        ARRANGEMENTS[Arrangement requests, schedules, payments, and refunds]
        SHOP_CENTER[Shop verification, products, customers, and reports]
        COMMUNICATIONS[Chat, notifications, announcements, support, and feedback]
        OPERATIONS[Administration, moderation, analytics, and audit]
    end

    subgraph SUPABASE[Supabase platform]
        SUPA_AUTH[Supabase Auth]
        DATABASE[(PostgreSQL with RLS)]
        STORAGE[(Supabase Storage)]
        REALTIME[Supabase Realtime]
        FUNCTIONS[Database functions, triggers, and Edge Functions]
    end

    PUSH[Expo Push Service]

    CUSTOMER --> MOBILE
    CUSTOMER --> WEB
    SHOP --> MOBILE
    SHOP --> WEB
    ADMIN --> MOBILE
    ADMIN --> WEB

    MOBILE --> AUTH
    MOBILE --> MARKETPLACE
    MOBILE --> ARRANGEMENTS
    MOBILE --> SHOP_CENTER
    MOBILE --> COMMUNICATIONS
    MOBILE --> OPERATIONS
    WEB --> AUTH
    WEB --> MARKETPLACE
    WEB --> ARRANGEMENTS
    WEB --> SHOP_CENTER
    WEB --> COMMUNICATIONS
    WEB --> OPERATIONS

    AUTH --> SUPA_AUTH
    AUTH --> DATABASE
    MARKETPLACE --> DATABASE
    ARRANGEMENTS --> DATABASE
    ARRANGEMENTS --> STORAGE
    SHOP_CENTER --> DATABASE
    SHOP_CENTER --> STORAGE
    COMMUNICATIONS --> DATABASE
    COMMUNICATIONS --> REALTIME
    COMMUNICATIONS --> PUSH
    OPERATIONS --> DATABASE
    FUNCTIONS --> DATABASE
    FUNCTIONS --> PUSH

    classDef actor fill:#fff4c2,stroke:#b7791f,stroke-width:2px,color:#1a1a1a;
    classDef client fill:#f6f1e8,stroke:#8b5e3c,stroke-width:1.5px,color:#1a1a1a;
    classDef module fill:#e8f0e8,stroke:#2f855a,stroke-width:1.5px,color:#1a1a1a;
    classDef platform fill:#e5eef8,stroke:#2b6cb0,stroke-width:1.5px,color:#1a1a1a;
    classDef external fill:#f4e8ff,stroke:#6b46c1,stroke-width:1.5px,color:#1a1a1a;

    class CUSTOMER,SHOP,ADMIN actor;
    class MOBILE,WEB client;
    class AUTH,MARKETPLACE,ARRANGEMENTS,SHOP_CENTER,COMMUNICATIONS,OPERATIONS module;
    class SUPA_AUTH,DATABASE,STORAGE,REALTIME,FUNCTIONS platform;
    class PUSH external;
