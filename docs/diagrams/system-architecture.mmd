flowchart LR
    %% =======================
    %% BLOODLINK SYSTEM ARCHITECTURE
    %% =======================

    subgraph ACT[Actors]
        U[User / Donor / Requester]
        F[Funeral Customer]
        S[Funeral Shop Staff]
        A[Super Admin / Admin / Blood Admin / Funeral Admin]
    end

    subgraph CLIENT[Client Applications]
        direction TB
        M[Mobile App\nExpo + React Native]
        W[Web App\nVite + React]
    end

    subgraph MOBILE[Mobile App Modules]
        direction TB
        M1[Auth + Role Gate]
        M2[User Screens]
        M3[Admin Screens]
        M4[Funeral Screens]
        M5[Shared Chat / Notifications]
        M6[User Request Actions\ncancel before shop accepts]
        M7[Shop Product Management\nadd / edit / delete products]
    end

    subgraph WEB[Web App Modules]
        direction TB
        W1[Auth + Protected Routes]
        W2[User Portal]
        W3[Admin Panel]
        W4[Support / Feedback]
        W5[User Service Request Actions\ncancel before shop accepts]
        W6[Shop Product Management\nadd / edit / delete products]
    end

    subgraph FB[Supabase Backend]
        direction TB
        FA[Supabase Authentication]
        FS[(Cloud SupabaseDB)]
        FR[SupabaseDB Security Rules]
    end

    subgraph DATA[Core SupabaseDB Collections]
        direction TB
        D1[(users)]
        D2[(requests)]
        D3[(funeral_service_requests)]
        D11[(funeral_products)]
        D4[(notifications)]
        D5[(conversations / messages)]
        D6[(announcements)]
        D7[(abuse_reports)]
        D8[(admin_audit_logs)]
        D9[(settings/admin)]
        D10[(app_feedback / ratings)]
    end

    subgraph EXT[External Services]
        direction TB
        C[Supabase Storage\nimage uploads]
        O[OpenStreetMap / Geocoding]
    end

